# Copy to .env and fill in. Never commit .env.

# --- Script LLM: FREE Gemini by default. Only the selected provider's key is needed. ---
LLM_PROVIDER=gemini            # gemini (free) | groq (free) | anthropic (paid)
# Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash  # gemini-2.0-flash / 1.5-flash were retired by Google
GEMINI_FALLBACK_MODEL=gemini-3.8-flash   # used automatically if the primary model returns 404
# Groq: free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Anthropic (paid, only if LLM_PROVIDER=anthropic) ---------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
ANTHROPIC_FALLBACK_MODEL=claude-3-5-sonnet-latest   # used automatically if the primary model returns 404

# --- Providers: FREE by default. Switch to paid by changing one line each. -------------
TTS_PROVIDER=edge_tts          # edge_tts (free, best on your PC) | kokoro (free, local; used in GitHub Actions) | elevenlabs (paid)
WHISPER_PROVIDER=faster_whisper  # faster_whisper (free, local) | openai (paid, needs OPENAI_API_KEY)

# Edge TTS: Microsoft neural voices, no key. List voices: python -m edge_tts --list-voices
EDGE_TTS_VOICE=en-US-ChristopherNeural
EDGE_TTS_RATE=-5%              # speaking speed (+8% sounded rushed)

# Kokoro: open-source voice that runs on your machine (no key, no internet service). ~350 MB model downloads on first use.
KOKORO_VOICE=am_michael        # am_* male, af_* female (US), bm_/bf_* British; channels/*.json override it
KOKORO_SPEED=1.0               # 0.5 - 2.0

# Caption timing: auto = Edge TTS's own word boundaries (calibrated on the audio), whisper = always use Whisper
WORD_TIMING_SOURCE=auto

# faster-whisper: runs on your machine; the model downloads on first use (base.en ~ 140 MB)
FASTER_WHISPER_MODEL=base.en   # tiny.en | base.en | small.en
FASTER_WHISPER_DEVICE=cpu      # cpu | cuda | auto
FASTER_WHISPER_COMPUTE_TYPE=int8

# --- ElevenLabs (paid, only if TTS_PROVIDER=elevenlabs): voice-over ------------------------------------------------------
ELEVENLABS_API_KEY=
# Any voice from your ElevenLabs library (Voices -> copy Voice ID)
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.35      # lower = more energetic / expressive
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.55
ELEVENLABS_SPEED=1.08          # 0.7 - 1.2, slightly fast = higher tempo

# --- OpenAI Whisper API (paid, only if WHISPER_PROVIDER=openai) ---------------------------------------
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# --- YouTube upload (OAuth2) -----------------------------------------------------
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_TOKEN_FILE=token.json
YOUTUBE_PRIVACY=private        # private | unlisted | public
YOUTUBE_CATEGORY_ID=27         # 27 Education, 24 Entertainment, 28 Science & Tech
YOUTUBE_SYNTHETIC_DISCLOSURE=true   # declare AI-generated/altered content

# --- Video ----------------------------------------------------------------------------
FPS=60                         # 30 or 60 (60 = smooth motion + finer SFX sync, slower render)
ACCENT_COLOR=#FFE600
TAIL_SECONDS=0.45             # pause after the last word, then the loop restarts
SEAMLESS_LOOP=true
