        "sfx": "pop"
      },
      {
        "id": 3,
        "text": "They relied on the Phillips Curve, a simple trade-off between jobs and prices.",
        "duration_estimate": 4.0,
        "motion_action": {
          "type": "CHART",
          "trend": "DOWN",
          "label": "THE PHILLIPS CURVE"
        },
        "sfx": "none"
